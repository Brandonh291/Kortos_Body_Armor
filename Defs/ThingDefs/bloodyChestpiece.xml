				<filter>
					<thingDefs>
					<li>Steel</li>
				</thingDefs>
				</filter>
				<count>60</count>
			</li>
		</ingredients>
		
		<fixedIngredientFilter>
			<categories>
				<li>Corpses</li>
			</categories>
			<thingDefs>
				<li>Steel</li>
			</thingDefs>
			<disallowedCategories>
