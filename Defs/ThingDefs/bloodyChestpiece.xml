<?xml version="1.0" encoding="utf-8" ?>
<Defs>
	<RecipeDef>
		<defName>MakeBoneArmor</defName>
		<label>Bone Plate Armor</label>
		<description>Overlapping solid plates of armor covering the entire body from neck to feet, then doused in blood for good measure. However, it is much weaker than other materials. While cheaper and lighter than normal plate, it is far more fragile and quickly breaks. The blood of the armor improves injury recover.</description>
		<jobString>Creating Armor from Bodies.</jobString>
		<workAmount>12000</workAmount>
		<effectWorking>Cremate</effectWorking>
		<soundWorking>Recipe_Smith</soundWorking>
		<workSpeedStat>GeneralLaborSpeed</workSpeedStat>
		<autoStripCorpses>true</autoStripCorpses>
		<workSkill>Crafting</workSkill>
		<workSkillLearnFactor>1.0</workSkillLearnFactor>
		<skillRequirements>
			<Crafting>6</Crafting>
		</skillRequirements>
		
		<ingredients>
